{
  "name": "rag-reliability-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @rag/web",
    "build": "npm run build --workspace @rag/web",
    "start": "npm run start --workspace @rag/web",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "typecheck": "npm run typecheck --workspace @rag/web && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.tools.json",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "check": "npm run lint && npm run typecheck",
    "prepare": "node .husky/install.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "6.0.3"
  }
}
