# Local workspace configuration. Copy to .env; never commit secrets.
# This development password is for loopback-only local use.
POSTGRES_PASSWORD=rag_local_only
POSTGRES_PORT=5432
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
DATABASE_URL=postgresql+psycopg://rag:rag_local_only@127.0.0.1:5432/rag
ARTIFACT_ROOT=./data/artifacts
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=52428800
EXTRACTION_TIMEOUT_SECONDS=60
MAX_EXTRACTED_CHARACTERS=2000000
MAX_PDF_PAGES=1000
MAX_RUN_QUESTIONS=1000
MAX_JSONL_BYTES=10485760
WORKER_CONCURRENCY=1
WORKER_POLL_SECONDS=15
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20
JOB_MAX_ATTEMPTS=3
MODEL_TIMEOUT_SECONDS=120
MODEL_CACHE_DIR=./data/models
EMBEDDING_THREADS=2
EMBEDDING_BATCH_SIZE=16
MAX_DENSE_CHUNKS=10000
# Dense currently uses the fixed pinned MiniLM CPU contract.
# These model-selection placeholders are reserved for future adapters.
EMBEDDING_MODEL_ID=
EMBEDDING_MODEL_REVISION=
RERANKER_MODEL_ID=
RERANKER_MODEL_REVISION=
# Explicit opt-in provider configuration; keys never sent to the browser.
# Local CPU model is opt-in. No paid provider is called by M4.
LOCAL_GENERATION_ENABLED=false
GENERATION_TIMEOUT_SECONDS=300
GENERATION_THREADS=2
SOURCE_REVISION=unrecorded
GENERATION_PROVIDER=
GENERATION_MODEL_ID=
GENERATION_API_KEY=
JUDGE_PROVIDER=
JUDGE_MODEL_ID=
JUDGE_API_KEY=
